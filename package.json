{
  "name": "vira-bicho",
  "private": true,
  "version": "1.0.0",
  "description": "Battle royale de monstrinhos: você vira o que você come.",
  "type": "module",
  "workspaces": [
    "shared",
    "server",
    "client",
    "observer"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:obs": "tsx scripts/obs-dev.ts",
    "build": "npm run build:client && npm run build:server && npm run build:obs",
    "build:client": "vite build --config client/vite.config.ts",
    "build:server": "node scripts/build-server.mjs",
    "build:obs": "node scripts/build-obs.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p observer/tsconfig.public.json",
    "test": "vitest run",
    "sim": "tsx scripts/sim.ts",
    "start": "node dist/server.mjs",
    "start:obs": "node dist/obs.mjs",
    "deploy": "bash scripts/deploy.sh"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
