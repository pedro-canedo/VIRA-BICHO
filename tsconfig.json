{
  "compilerOptions": {
    "target": "es2023",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2023", "dom", "dom.iterable"],
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "noUncheckedIndexedAccess": false,
    "resolveJsonModule": true
  },
  "include": ["shared/src", "server/src", "client/src", "observer/src", "tests", "scripts/*.ts", "client/vite.config.ts", "vitest.config.ts"]
}
